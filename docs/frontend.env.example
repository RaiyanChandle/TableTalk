# =====================================================================
# frontend/.env.example
# Copy this file to frontend/.env.
# Anything starting with VITE_ is bundled into the browser build,
# so NEVER put secrets (API keys, JWT secret) in this file.
# =====================================================================

# Backend URL. In development you can leave this empty and use the
# Vite proxy (/api -> http://localhost:4000) so cookies work as same-origin.
# In production set it to your API domain, e.g. https://api.example.com
VITE_API_URL=

# Client-side upload checks (the backend enforces the real limits)
VITE_MAX_FILES=10
VITE_MAX_FILE_MB=25
VITE_MAX_DATASETS_PER_CHAT=5

# =====================================================================
# backend/.env.example
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env. Only commit this example file.
# =====================================================================

# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Origin of the frontend (used for CORS with credentials). No trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database ----------
MONGODB_URI=mongodb://localhost:27017/ai-data-analyst

# ---------- Auth ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=session
# lax for same-site setups (Vite proxy in dev, subdomains in prod); none only for unrelated domains
COOKIE_SAME_SITE=lax
# false on http://localhost, true in production (https)
COOKIE_SECURE=false
BCRYPT_COST=12

# ---------- Gemini API ----------
# Create a key in Google AI Studio. Keep it on the backend only.
GOOGLE_API_KEY=your-gemini-api-key
# Use a current stable Gemini Flash model ID from the Gemini API models page / AI Studio.
# Model names change over time, so check the list before deploying.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3

# ---------- Agent ----------
# Version string stored in every run log and shown in the report
PROMPT_VERSION=v1
AGENT_MAX_STEPS=12
AGENT_MAX_SQL_ATTEMPTS=3
# Number of previous messages passed to the agent for follow-up questions
AGENT_HISTORY_MESSAGES=6

# ---------- Uploads ----------
STORAGE_DIR=./storage
MAX_FILES_PER_UPLOAD=10
MAX_FILE_MB=25
MAX_UPLOAD_TOTAL_MB=100
MAX_TABLES_PER_CONVERSATION=5

# ---------- SQL sandbox (DuckDB) ----------
SQL_TIMEOUT_MS=5000
SQL_MEMORY_LIMIT=512MB
SQL_THREADS=2
SQL_MAX_RESULT_ROWS=1000
# Rows of each result that the LLM is allowed to see
SQL_ROWS_TO_LLM=50

# ---------- Rate limiting ----------
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
CHAT_RATE_LIMIT_PER_HOUR=30
UPLOAD_RATE_LIMIT_PER_HOUR=20

# ---------- Logging / observability ----------
LOG_LEVEL=info
# Optional LangSmith tracing (leave false and empty if unused)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-data-analyst

